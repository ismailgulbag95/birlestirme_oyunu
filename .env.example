# Real rewarded ad unit ID. Keep Google demo IDs in `npm run build:android:test` only.
VITE_ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-REPLACE_ME/REPLACE_ME

# Set these in the build shell for Android release signing and AdMob app setup.
ADMOB_APP_ID=ca-app-pub-REPLACE_ME~REPLACE_ME
ANDROID_KEYSTORE_PATH=D:/secure/path/upload-key.jks
ANDROID_KEYSTORE_PASSWORD=REPLACE_ME
ANDROID_KEY_ALIAS=REPLACE_ME
ANDROID_KEY_PASSWORD=REPLACE_ME
